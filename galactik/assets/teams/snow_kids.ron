    // x: 0 = own goal line, 1 = opponent goal line. y: -1 left, 1 right.
    attack: Formation(name: "2-2-2", anchors: [
        (0.04, 0.0),
        (0.30, -0.45), (0.30, 0.45),
        (0.55, -0.35), (0.55, 0.35),
        (0.78, -0.25), (0.80, 0.25),
