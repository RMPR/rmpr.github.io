#![enable(implicit_some)]
// Snow Kids of Akillian. Stat values are tuning starting points, not canon.
TeamDef(
    id: "snow_kids",
    name: "Snow Kids",
    short_name: "SNK",
    home: "Akillian",
    coach: "Aarch",
    flux: Breath,
