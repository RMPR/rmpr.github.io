                strength: 74, stamina: 80, reactions: 86, gk_reflex: 10, gk_reach: 10,
                flux_power: 65, flux_control: 80),
            signature: Some("ice_wall")),
        PlayerDef(id: "mei", name: "Mei", number: 3, pos: DF, starter: true, accent: "#1F1F1F",
            stats: Stats(pace: 82, acceleration: 80, ball_control: 72, dribbling: 68,
                short_pass: 72, long_pass: 70, shooting: 58, heading: 80, tackle: 78,
                strength: 62, stamina: 78, reactions: 80, gk_reflex: 10, gk_reach: 10,
                flux_power: 68, flux_control: 72),
            signature: Some("blizzard_clear")),
        PlayerDef(id: "rocket", name: "Rocket", number: 4, pos: MF, starter: true, accent: "#5A3A1E",
            stats: Stats(pace: 76, acceleration: 74, ball_control: 86, dribbling: 80,
