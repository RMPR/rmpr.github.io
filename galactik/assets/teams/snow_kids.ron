                strength: 50, stamina: 76, reactions: 82, gk_reflex: 10, gk_reach: 10,
                flux_power: 88, flux_control: 95),
            signature: Some("glacier_pass")),
        PlayerDef(id: "micro_ice", name: "Micro-Ice", number: 6, pos: ST, starter: true, accent: "#2E6BFF",
