    defend: Formation(name: "3-2-1", anchors: [
        (0.04, 0.0),
        (0.18, -0.45), (0.18, 0.45),
        (0.35, -0.30), (0.35, 0.30),
        (0.50, -0.15), (0.55, 0.15),
